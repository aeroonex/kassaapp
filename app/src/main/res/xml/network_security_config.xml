<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (plain HTTP) is allowed only for private/LAN addresses, so the
  app can talk to a monitoring server running on a test machine during
  local development (e.g. http://192.168.x.x:3000). Any public hostname
  still requires HTTPS — the production server must sit behind TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
