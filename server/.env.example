# Nusxa oling: cp .env.example .env

PORT=3000

# Web panelga kirish uchun admin login/parol
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Session cookie imzolash kaliti — tasodifiy uzun satrga almashtiring
SESSION_SECRET=change-me-too

# Telefonlar skrinshot yuklaganda yuborishi kerak bo'lgan maxfiy token
# (Android tomonida ApiConfig.setUploadToken bilan bir xil bo'lishi kerak)
UPLOAD_TOKEN=change-me-device-token

# Skrinshotlarni necha kun saqlash (shundan eski bo'lganlari avtomatik o'chadi)
RETENTION_DAYS=30
